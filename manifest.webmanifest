{
  "id": "./",
  "name": "MBCPLAY — Mauritian TV & Radio",
  "short_name": "MBCPLAY",
  "description": "Watch and listen to Mauritian TV and radio channels live. Open-source player by Jonathan COLLET.",
  "lang": "en",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0b0d12",
  "theme_color": "#0b0d12",
  "categories": ["entertainment", "news", "sports"],
  "icons": [
    { "src": "assets/img/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/img/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "assets/img/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "MBC 1", "url": "./#mbc-1", "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "MBC 2", "url": "./#mbc-2", "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Sports 11", "url": "./#sports-11", "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }] },
    { "name": "Radio Rodrigues", "url": "./#radio-rodrigues", "icons": [{ "src": "assets/img/icon-192.png", "sizes": "192x192" }] }
  ]
}
